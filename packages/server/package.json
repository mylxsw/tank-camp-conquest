{
  "name": "@tcc/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm exec tsc -p ../shared/tsconfig.json && tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@tcc/shared": "workspace:*",
    "@colyseus/schema": "^2.0.35",
    "colyseus": "^0.15.26",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
