NODE_ENV=production

# --- HTTPS（有域名，推荐）---
# 1) DNS A/AAAA 指到本机公网 IP
# 2) 下面三项填同一域名
DOMAIN=tank.example.com
PUBLIC_HOST=tank.example.com
SITE_ADDRESS=tank.example.com
ACME_EMAIL=you@example.com

# --- HTTP 回退（仅 IP / 无证书）---
# DOMAIN=
# PUBLIC_HOST=YOUR_VPS_IP
# SITE_ADDRESS=:80
# ACME_EMAIL=

HTTP_PORT=80
HTTPS_PORT=443
SERVER_PORT=2567
COLYSEUS_PATH=/colyseus
# 空 = 浏览器按当前页自动 ws:// 或 wss:// + 主机 + /colyseus
COLYSEUS_URL=
